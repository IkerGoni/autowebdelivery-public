# Auto Web project — generated/local files
# Keep docs, contracts, fixtures, prompts, and source code committed.
# Do not commit secrets, generated lead data, deployments, screenshots, or local build artifacts.

# --- OS / editor noise ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secret
secrets/
credentials/
*.credentials.json
service-account*.json
vercel.json.local

